# ==========================================================
# BrewLite – cấu hình mẫu
# Copy file này thành .env và điền giá trị thật:
#   cp .env.example .env
# KHÔNG BAO GIỜ commit file .env thật lên repository.
# ==========================================================

# ---------- Docker Compose (local) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5433

# ---------- API (NestJS) ----------
NODE_ENV=development
PORT=4000
# Chuỗi kết nối PostgreSQL dùng trong Docker Compose (service name = postgres)
DATABASE_URL=postgresql://postgres:123456@postgres:5432/brewlite_db?schema=public
# Khi chạy API ngoài Docker (local host) dùng cổng HOST 5433 (tránh đụng PostgreSQL hệ thống ở 5432):
# DATABASE_URL=postgresql://postgres:change-me-local@localhost:5433/brewlite_db?schema=public

# JWT – đặt chuỗi ngẫu nhiên dài (sinh bằng: openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Mock Payment Service (mô phỏng Momo / VNPay / Stripe)
PAYMENT_PROVIDER=mock
PAYMENT_SUCCESS_RATE=0.9

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL public của API ở production (dùng cho tài liệu deployment)
PRODUCTION_API_URL=https://brewlite-api.onrender.com
