@startuml class-domain
'==============================================================
' BrewLite – Class diagram ở mức domain
' Task 2.3 (Assignment 2)
' Nguồn: docs/requirements/srs.md + apps/api/prisma/schema.prisma
'==============================================================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam class {
  BackgroundColor #F5F7FA
  BorderColor #2C3E50
  FontColor #1B2631
  ArrowColor #2C3E50
}
skinparam enum {
  BackgroundColor #FDEBD0
  BorderColor #B9770E
  FontColor #5D4037
}
skinparam stereotypeCBackgroundColor #FDEBD0

hide empty members

'---------------- Enumerations ----------------
enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

'---------------- Entities ----------------
class User {
  - id : int
  - email : string <<unique>>
  - passwordHash : string
  - role : UserRole
  - loyaltyPoints : int
  - createdAt : DateTime
  --
  + register(email, password) : void
  + login(email, password) : string
}

class Product {
  - id : int
  - name : string
  - description : string
  - price : decimal
  - imageUrl : string
  - category : string
  - stock : int
  - version : int <<optimistic locking>>
  - isAvailable : boolean
  - createdAt : DateTime
}

class ProductSize {
  - id : int
  - code : string <<S|M|L>>
  - name : string
  - priceDelta : decimal
  - isDefault : boolean
}

class Topping {
  - id : int
  - name : string
  - price : decimal
  - isAvailable : boolean
}

class Order {
  - id : int
  - code : string <<unique, "#1042">>
  - userId : int
  - status : OrderStatus
  - total : decimal
  - subtotal : decimal
  - discount : decimal
  - promotionId : int?
  - createdAt : DateTime
  - updatedAt : DateTime
  --
  + assertTransition(to : OrderStatus) : void
  + addItem(item : OrderItem) : void
  + calculateTotal() : decimal
}

class OrderItem {
  - id : int
  - orderId : int
  - productId : int
  - sizeCode : string
  - qty : int
  - unitPrice : decimal
  - lineTotal : decimal
}

class OrderItemTopping {
  - id : int
  - orderItemId : int
  - toppingId : int
  - price : decimal
}

class Payment {
  - id : int
  - orderId : int
  - idempotencyKey : string <<unique>>
  - amount : decimal
  - method : PaymentMethod
  - status : PaymentStatus
  - transactionRef : string?
  - failureReason : string?
  - createdAt : DateTime
}

class Promotion {
  - id : int
  - code : string <<unique>>
  - description : string
  - discountType : DiscountType
  - discountValue : decimal
  - minOrderTotal : decimal
  - maxUsage : int?
  - usedCount : int
  - startsAt : DateTime
  - expiresAt : DateTime
  - isActive : boolean
  --
  + isValid(orderTotal) : boolean
  + calculateDiscount(orderTotal) : decimal
}

class LoyaltyTransaction {
  - id : int
  - userId : int
  - orderId : int?
  - type : LoyaltyTransactionType
  - points : int
  - description : string
  - createdAt : DateTime
}

class OrderStatusHistory {
  - id : int
  - orderId : int
  - fromStatus : OrderStatus
  - toStatus : OrderStatus
  - actorId : int?
  - createdAt : DateTime
}

'---------------- Relations ----------------
User "1" --> "0..*" Order : đặt >
User "1" --> "0..*" LoyaltyTransaction : tích lũy >
Order "1" *-- "1..*" OrderItem : chứa >
Order "1" --> "0..1" Promotion : áp dụng >
Order "1" --> "0..*" Payment : được thanh toán bằng >
Order "1" --> "0..*" OrderStatusHistory : có lịch sử >
OrderItem "1" --> "1" Product : chứa >
OrderItem "1" --> "0..1" ProductSize : có >
OrderItem "1" *-- "0..*" OrderItemTopping : >
OrderItemTopping "1" --> "1" Topping : >
Product "1" o-- "1..*" ProductSize : có >
Product "1" o-- "0..*" Topping : chấp nhận >
LoyaltyTransaction "0..*" --> "0..1" Order : phát sinh từ >
Payment "0..*" --> "1" Order : thanh toán cho >

note right of OrderStatus
  **Máy trạng thái đơn hàng**
  PENDING → PAID → PREPARING
            → READY → COMPLETED

  Ngoại lệ:
  PENDING → PAYMENT_FAILED → PAID
  PENDING | PAID → CANCELLED

  COMPLETED & CANCELLED là trạng thái
  kết thúc (không chuyển tiếp được).
  Mọi chuyển trạng thái ngoài danh sách
  trên bị assertTransition() chặn.
end note

note right of Payment
  **Idempotency**
  idempotencyKey có ràng buộc UNIQUE.
  Gửi lại cùng key → trả kết quả cũ,
  không tạo giao dịch/điểm thưởng lần 2.
end note

note right of LoyaltyTransaction
  Điểm thưởng = floor(order.total / 1000),
  chỉ cộng khi đơn chuyển sang PAID.
end note

@enduml
