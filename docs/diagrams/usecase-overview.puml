@startuml usecase-overview
'==============================================================
' BrewLite – Sơ đồ use-case tổng quát của toàn hệ thống
' Task 1.2 (Assignment 2) | Nguồn: docs/requirements/srs.md
'==============================================================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam usecase {
  BackgroundColor #F5F7FA
  BorderColor #2C3E50
  ArrowColor #2C3E50
  FontColor #1B2631
}
skinparam actor {
  BackgroundColor #2C3E50
  BorderColor #1B2631
  FontColor #FFFFFF
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  FontStyle bold
}

left to right direction

actor "Khách hàng" as Customer
actor "Nhân viên quầy\n(Barista)" as Barista
actor "Quản lý cửa hàng /\nProduct Owner" as Manager

rectangle "Hệ thống BrewLite" {
  usecase "UC-01\nXem menu sản phẩm" as UC01
  usecase "UC-02\nXem chi tiết sản phẩm" as UC02
  usecase "UC-03\nChọn size & topping\n(tính giá)" as UC03
  usecase "UC-04\nQuản lý giỏ hàng" as UC04
  usecase "UC-05\nĐăng ký / Đăng nhập\n(JWT)" as UC05
  usecase "UC-07\nĐặt và thanh toán\nđơn hàng" as UC07 <<focus>>
  usecase "UC-08\nXem lịch sử đơn" as UC08
  usecase "UC-09\nCập nhật trạng thái đơn" as UC09
  usecase "UC-10\nQuản lý menu &\nkhuyến mãi" as UC10
}

' --- Quan hệ khách hàng ---
Customer --> UC01
Customer --> UC02
Customer --> UC03
Customer --> UC04
Customer --> UC05
Customer --> UC07
Customer --> UC08

' --- Quan hệ nhân viên ---
Barista --> UC09

' --- Quan hệ quản lý ---
Manager --> UC10
Manager --> UC08

' --- Quan hệ <<include>> / <<extend>> ---
UC02 ..> UC03 : <<include>>\n(tính giá theo tùy chọn)
UC07 ..> UC05 : <<include>>\n(yêu cầu đăng nhập)
UC07 ..> UC08 : <<extend>>\n(xem lại đơn sau khi đặt)
UC09 ..> UC08 : <<include>>\n(danh sách đơn cần xử lý)
UC10 ..> UC01 : <<include>>\n(dữ liệu menu)

note right of UC07
  **Use-case trọng tâm**
  (Task 1.3 – đặc tả chi tiết tại
  docs/requirements/use-case-checkout.md)
end note

note bottom of UC09
  Ngoài phạm vi MVP:
  giữ trong backlog mở rộng
  (context-and-scope.md §3.2)
end note

note bottom of UC10
  Ngoài phạm vi MVP:
  quản trị bằng seed/migration
end note

@enduml
