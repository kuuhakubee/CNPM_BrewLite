# ==========================================================
# BrewLite API – biến môi trường mẫu (chạy API TRÊN HOST)
# Copy file này thành apps/api/.env rồi điền giá trị thật:
#   Debian/Linux:  cp apps/api/.env.example apps/api/.env
#   Windows (PS):  Copy-Item apps/api/.env.example apps/api/.env
#
# KHÔNG commit file .env thật (đã bị .gitignore chặn).
#
# LƯU Ý: Khi chạy API BẰNG DOCKER COMPOSE, các biến này được
# khai báo trực tiếp trong docker-compose.yml (service "api"),
# nên file này KHÔNG bắt buộc. Chỉ cần khi chạy `npm run start:dev`
# trên máy host.
# ==========================================================

# Cổng HOST của PostgreSQL container là 5433 (tránh đụng PostgreSQL
# hệ thống ở 5432). Bên trong Docker network vẫn dùng postgres:5432.
DATABASE_URL="postgresql://postgres:change-me-local@localhost:5433/brewlite_db?schema=public"

NODE_ENV=development
PORT=4000

# Sinh chuỗi ngẫu nhiên: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Mock payment gateway (mô phỏng Momo/VNPay/Stripe)
PAYMENT_PROVIDER=mock
PAYMENT_SUCCESS_RATE=0.9
