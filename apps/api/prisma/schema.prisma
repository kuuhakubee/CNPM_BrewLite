datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// =========================================================================
// Enums – khớp với class diagram (docs/diagrams/class-domain.puml) & ADR-002
// =========================================================================

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  FAILED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
  FREE_SHIPPING
}

// =========================================================================
// Entities – nguồn sự thật duy nhất cho mô hình dữ liệu (ADR-002)
// Tiền tệ: Decimal(12,2) để tránh lỗi làm tròn nhị phân (AC-09-5)
// =========================================================================

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  role          UserRole @default(CUSTOMER)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())

  orders               Order[]
  loyaltyTransactions  LoyaltyTransaction[]

  @@map("users")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String  @default("")
  price       Decimal @db.Decimal(12, 2)
  imageUrl    String  @default("")
  category    String  @default("coffee")
  stock       Int     @default(100)
  // Optimistic locking – tăng mỗi lần trừ kho (ADR-004, AC-N03-2)
  version     Int     @default(0)
  isAvailable Boolean @default(true)
  createdAt   DateTime @default(now())

  sizes        ProductSize[]
  toppings     Topping[]     @relation("ProductAcceptsTopping")
  orderItems   OrderItem[]

  @@map("products")
}

model ProductSize {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  code       String // S, M, L
  name       String
  priceDelta Decimal @db.Decimal(12, 2) @default(0)
  isDefault  Boolean @default(false)

  orderItems OrderItem[]

  @@unique([productId, code])
  @@map("product_sizes")
}

model Topping {
  id          Int     @id @default(autoincrement())
  name        String
  price       Decimal @db.Decimal(12, 2)
  isAvailable Boolean @default(true)

  products       Product[]         @relation("ProductAcceptsTopping")
  orderItemToppings OrderItemTopping[]

  @@map("toppings")
}

model Order {
  id       Int         @id @default(autoincrement())
  // Mã đơn hiển thị cho khách, dạng "#1042"
  code     String      @unique
  userId   Int
  user     User        @relation(fields: [userId], references: [id])
  status   OrderStatus @default(PENDING)
  subtotal Decimal     @db.Decimal(12, 2)
  discount Decimal     @default(0) @db.Decimal(12, 2)
  total    Decimal     @db.Decimal(12, 2)
  promotionId Int?
  promotion Promotion? @relation(fields: [promotionId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items           OrderItem[]
  payments        Payment[]
  statusHistory   OrderStatusHistory[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  // Mã size đã chọn (S/M/L) – lưu trực tiếp để bất biến khi snapshot đơn
  sizeCode  String
  // Optional relation tới ProductSize (xem class diagram)
  productSizeId Int?
  productSize   ProductSize? @relation(fields: [productSizeId], references: [id])
  qty       Int
  // Đơn giá đã tính lại từ DB: basePrice + sizeDelta + Σ(topping)
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  toppings OrderItemTopping[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemTopping {
  id          Int     @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toppingId   Int
  topping     Topping   @relation(fields: [toppingId], references: [id])
  // Snapshot giá tại thời điểm đặt hàng
  price       Decimal   @db.Decimal(12, 2)

  @@index([orderItemId])
  @@map("order_item_toppings")
}

model Payment {
  id             Int            @id @default(autoincrement())
  orderId        Int
  order          Order          @relation(fields: [orderId], references: [id])
  // Ràng buộc UNIQUE – idempotency được đảm bảo bởi DB (ADR-004, AC-N03-3)
  idempotencyKey String         @unique
  amount         Decimal        @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus
  transactionRef String?
  failureReason  String?
  createdAt      DateTime       @default(now())

  @@index([orderId])
  @@map("payments")
}

model Promotion {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  description    String       @default("")
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  minOrderTotal  Decimal      @default(0) @db.Decimal(12, 2)
  maxUsage       Int?
  usedCount      Int          @default(0)
  startsAt       DateTime
  expiresAt      DateTime
  isActive       Boolean      @default(true)

  orders Order[]

  @@map("promotions")
}

model LoyaltyTransaction {
  id      Int                  @id @default(autoincrement())
  userId  Int
  user    User                 @relation(fields: [userId], references: [id])
  orderId Int?
  order   Order?               @relation(fields: [orderId], references: [id])
  type    LoyaltyTransactionType
  points  Int
  description String           @default("")
  createdAt DateTime           @default(now())

  @@index([userId])
  @@map("loyalty_transactions")
}

model OrderStatusHistory {
  id         Int         @id @default(autoincrement())
  orderId    Int
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  // Ai thực hiện chuyển trạng thái (null = hệ thống)
  actorId    Int?
  createdAt  DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}
